rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function checking if caller is authenticated and matches document owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Financial collections require a freshly issued token carrying Firebase Auth's
    // verified-email claim. The parent user document intentionally remains owner-only
    // so registration/profile bootstrap is not blocked.
    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    function isValidFcmRegistrationData(data, userId) {
      return data.keys().hasAll([
               'schemaVersion', 'userId', 'installationId', 'platform', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'schemaVersion', 'userId', 'installationId', 'platform', 'updatedAt'
             ]) &&
             data.schemaVersion is int && data.schemaVersion == 1 &&
             data.userId is string && data.userId == userId &&
             data.installationId is string &&
             data.installationId.size() > 0 && data.installationId.size() <= 256 &&
             data.platform == 'android' &&
             data.updatedAt == request.time;
    }

    function hasValidExpenseFields(data) {
      return data.keys().hasAll([
               'id', 'userId', 'categoryId', 'categoryNameSnapshot',
               'spendingClass', 'paymentChannel', 'originalAmountDecimal',
               'originalCurrency', 'rateLkrPerUnitDecimal', 'baseAmountMinor',
               'rateSource', 'rateDate', 'occurredDate', 'note',
               'channelLabel', 'recurringExpenseId', 'recurringOccurrenceId'
             ]) &&
             data.keys().hasOnly([
               'id', 'userId', 'categoryId', 'categoryNameSnapshot',
               'spendingClass', 'paymentChannel', 'originalAmountDecimal',
               'originalCurrency', 'rateLkrPerUnitDecimal', 'baseAmountMinor',
               'rateSource', 'rateDate', 'occurredDate', 'note',
               'channelLabel', 'recurringExpenseId', 'recurringOccurrenceId'
             ]);
    }

    function hasValidExpenseMoney(data) {
      return isPositiveAmountDecimal(data.originalAmountDecimal) &&
             data.originalAmountDecimal == data.originalAmountDecimal.trim() &&
             data.originalAmountDecimal.size() <= 24 &&
             isPositiveRateDecimal(data.rateLkrPerUnitDecimal) &&
             data.rateLkrPerUnitDecimal == data.rateLkrPerUnitDecimal.trim() &&
             data.rateLkrPerUnitDecimal.size() <= 24 &&
             data.baseAmountMinor is int && data.baseAmountMinor > 0 &&
             ((data.originalCurrency == 'LKR' &&
               data.rateSource == 'LKR_FIXED' &&
               isLkrUnitRate(data.rateLkrPerUnitDecimal) &&
               data.rateDate == data.occurredDate) ||
              (data.originalCurrency == 'USD' &&
               data.rateSource in [
                 'MANUAL_TRANSFER',
                 'MANUAL_REFERENCE',
                 'EXCHANGE_RATE_API_REFERENCE'
               ]));
    }

    function hasNoRecurringExpenseLink(data) {
      return (!('recurringExpenseId' in data) || data.recurringExpenseId == null) &&
             (!('recurringOccurrenceId' in data) || data.recurringOccurrenceId == null);
    }

    function hasValidExpenseRecurringLink(data, userId, expenseId) {
      return (data.recurringExpenseId == null &&
              data.recurringOccurrenceId == null) ||
             (data.recurringExpenseId is string &&
              data.recurringExpenseId.size() > 0 &&
              data.recurringOccurrenceId is string &&
              data.recurringOccurrenceId.size() > 0 &&
              expenseId == 'recurring_' + data.recurringOccurrenceId &&
              exists(/databases/$(database)/documents/users/$(userId)/recurringExpenses/$(data.recurringExpenseId)));
    }

    function preservesExpenseRecurringLink(before, after) {
      return (hasNoRecurringExpenseLink(before) &&
              after.recurringExpenseId == null &&
              after.recurringOccurrenceId == null) ||
             (before.recurringExpenseId is string &&
              before.recurringOccurrenceId is string &&
              after.recurringExpenseId == before.recurringExpenseId &&
              after.recurringOccurrenceId == before.recurringOccurrenceId);
    }

    // Exact Expense schema emitted by FirestoreExpenseRepository and recurring confirmation.
    // Firestore rules cannot safely reproduce arbitrary-precision decimal multiplication, so
    // baseAmountMinor consistency remains independently checked by the Android mapper.
    function isValidExpenseData(data, userId, expenseId) {
      return hasValidExpenseFields(data) &&
             data.id is string && data.id == expenseId &&
             data.userId is string && data.userId == userId &&
             data.categoryId is string &&
             data.categoryId.size() > 0 && data.categoryId.size() <= 256 &&
             exists(/databases/$(database)/documents/users/$(userId)/categories/$(data.categoryId)) &&
             data.categoryNameSnapshot is string &&
             data.categoryNameSnapshot.trim().size() > 0 &&
             data.categoryNameSnapshot.size() <= 50 &&
             data.spendingClass in ['COMMITTED', 'DISCRETIONARY'] &&
             data.paymentChannel in ['CASH', 'CARD', 'BANK', 'TRANSFER', 'OTHER'] &&
             isIsoDate(data.occurredDate) &&
             isIsoDate(data.rateDate) &&
             (data.note == null || data.note is string) &&
             (data.channelLabel == null || data.channelLabel is string) &&
             hasValidExpenseMoney(data) &&
             hasValidExpenseRecurringLink(data, userId, expenseId);
    }

    function isValidRecurringExpenseData(data, userId, recurringId) {
      return data.keys().hasAll([
               'id', 'userId', 'title', 'categoryId', 'expectedAmountMinor',
               'frequency', 'intervalCount', 'anchorDate', 'startDate',
               'endDate', 'status', 'paymentChannel', 'channelLabel',
               'reminderEnabled', 'reminderLeadDays'
             ]) &&
             data.keys().hasOnly([
               'id', 'userId', 'title', 'categoryId', 'expectedAmountMinor',
               'frequency', 'intervalCount', 'anchorDate', 'startDate',
               'endDate', 'status', 'paymentChannel', 'channelLabel',
               'reminderEnabled', 'reminderLeadDays', 'reminderTimeMinutes'
             ]) &&
             data.id == recurringId &&
             data.userId == userId &&
             data.title is string && data.title.trim().size() > 0 && data.title.size() <= 80 &&
             data.categoryId is string && data.categoryId.size() > 0 &&
             exists(/databases/$(database)/documents/users/$(userId)/categories/$(data.categoryId)) &&
             data.expectedAmountMinor is int && data.expectedAmountMinor > 0 &&
             data.frequency in ['WEEKLY', 'MONTHLY', 'YEARLY'] &&
             data.intervalCount is int && data.intervalCount > 0 && data.intervalCount <= 120 &&
             isIsoDate(data.anchorDate) &&
             isIsoDate(data.startDate) &&
             (data.endDate == null || isIsoDate(data.endDate)) &&
             data.status in ['ACTIVE', 'PAUSED', 'CANCELLED'] &&
             data.paymentChannel in ['CASH', 'CARD', 'BANK', 'TRANSFER', 'OTHER'] &&
             (data.channelLabel == null || data.channelLabel is string) &&
             data.reminderEnabled is bool &&
             data.reminderLeadDays is int &&
             data.reminderLeadDays >= 0 && data.reminderLeadDays <= 365 &&
             (!('reminderTimeMinutes' in data) ||
               (data.reminderTimeMinutes is int &&
                data.reminderTimeMinutes >= 0 &&
                data.reminderTimeMinutes < 1440));
    }

    function isValidRecurringOccurrenceData(data, userId, occurrenceId) {
      return data.keys().hasAll([
               'id', 'userId', 'recurringExpenseId', 'dueDate',
               'status', 'expenseId', 'actionAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'userId', 'recurringExpenseId', 'dueDate',
               'status', 'expenseId', 'actionAt'
             ]) &&
             data.id == occurrenceId &&
             data.userId == userId &&
             data.recurringExpenseId is string && data.recurringExpenseId.size() > 0 &&
             isIsoDate(data.dueDate) &&
             occurrenceId == data.recurringExpenseId + '_' + data.dueDate &&
             exists(/databases/$(database)/documents/users/$(userId)/recurringExpenses/$(data.recurringExpenseId)) &&
             data.status in ['CONFIRMED', 'SKIPPED'] &&
             data.actionAt is timestamp &&
             ((data.status == 'CONFIRMED' &&
               data.expenseId == 'recurring_' + occurrenceId &&
               existsAfter(/databases/$(database)/documents/users/$(userId)/expenses/$(data.expenseId)) &&
               getAfter(/databases/$(database)/documents/users/$(userId)/expenses/$(data.expenseId)).data.recurringExpenseId == data.recurringExpenseId &&
               getAfter(/databases/$(database)/documents/users/$(userId)/expenses/$(data.expenseId)).data.recurringOccurrenceId == occurrenceId) ||
              (data.status == 'SKIPPED' && data.expenseId == null));
    }

    // Category documents use the exact field set written by FirestoreCategoryRepository.
    function isValidCategoryData(data, categoryId) {
      return data.keys().hasAll(['id', 'name', 'defaultSpendingClass', 'archived']) &&
             data.keys().hasOnly(['id', 'name', 'defaultSpendingClass', 'archived']) &&
             data.id is string &&
             data.id == categoryId &&
             data.name is string &&
             data.name.trim().size() > 0 &&
             data.name.size() <= 50 &&
             data.defaultSpendingClass in ['COMMITTED', 'DISCRETIONARY'] &&
             data.archived is bool;
    }

    // Income documents use the exact v1 field set emitted by IncomeFirestoreMapper.
    function hasValidIncomeFields(data) {
      return data.keys().hasAll([
               'schemaVersion',
               'id',
               'source',
               'entryKind',
               'money',
               'occurredDate'
             ]) &&
             data.keys().hasOnly([
               'schemaVersion',
               'id',
               'source',
               'entryKind',
               'money',
               'occurredDate',
               'pnlDirection',
               'projectReference',
               'receivableId',
               'assetSymbol',
               'cryptoRealizedDetails',
               'note'
             ]);
    }

    function isIsoDate(value) {
      return value is string &&
             value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function isPositiveAmountDecimal(value) {
      return value is string &&
             value.trim().matches('[0-9]+([.][0-9]{1,2})?') &&
             !value.trim().matches('0+([.]0{1,2})?');
    }

    function isNonNegativeAmountDecimal(value) {
      return value is string &&
             value.trim().matches('[0-9]+([.][0-9]{1,2})?');
    }

    function isPositiveRateDecimal(value) {
      return value is string &&
             value.trim().matches('[0-9]+([.][0-9]{1,6})?') &&
             !value.trim().matches('0+([.]0{1,6})?');
    }

    // Precision-safe subset of BigDecimal representations that equal one.
    // Includes ordinary decimal forms, zero-exponent forms, and 10e-1 without float conversion.
    function isLkrUnitRate(value) {
      return value is string &&
             value.trim().matches(
               '[+]?0*(1([.]0*)?([eE][-+]?0+)?|10([.]0*)?[eE]-0*1)'
             );
    }

    function hasValidMoneyFields(money) {
      return money is map &&
             money.keys().hasAll([
               'originalAmountDecimal',
               'originalCurrency',
               'rateLkrPerUnitDecimal',
               'baseAmountMinor',
               'rateSource',
               'rateDate'
             ]) &&
             money.keys().hasOnly([
               'originalAmountDecimal',
               'originalCurrency',
               'rateLkrPerUnitDecimal',
               'baseAmountMinor',
               'rateSource',
               'rateDate'
             ]);
    }

    function hasValidMoneyTypes(money) {
      return isNonNegativeAmountDecimal(money.originalAmountDecimal) &&
             money.originalCurrency is string &&
             money.rateLkrPerUnitDecimal is string &&
             money.baseAmountMinor is int &&
             money.baseAmountMinor >= 0 &&
             money.rateSource is string &&
             isIsoDate(money.rateDate);
    }

    function hasValidCurrencyAndRate(data) {
      return (data.money.originalCurrency == 'LKR' &&
              data.money.rateSource == 'LKR_FIXED' &&
              isLkrUnitRate(data.money.rateLkrPerUnitDecimal) &&
              data.money.rateDate == data.occurredDate) ||
             (data.money.originalCurrency == 'USD' &&
              data.money.rateSource in [
                'MANUAL_TRANSFER',
                'MANUAL_REFERENCE',
                'EXCHANGE_RATE_API_REFERENCE'
              ] &&
              isPositiveRateDecimal(data.money.rateLkrPerUnitDecimal));
    }

    function hasValidOptionalIncomeTypes(data) {
      return (!('projectReference' in data) || data.projectReference is string) &&
             (!('receivableId' in data) || data.receivableId is string) &&
             (!('assetSymbol' in data) || data.assetSymbol is string) &&
             (!('cryptoRealizedDetails' in data) || data.cryptoRealizedDetails is map) &&
             (!('note' in data) || data.note is string);
    }

    function hasValidCryptoRealizedDetails(data) {
      return !('cryptoRealizedDetails' in data) ||
             (data.source == 'CRYPTO' &&
              data.entryKind == 'REALIZED_PNL' &&
              data.cryptoRealizedDetails.keys().hasAll([
                'costBasisOriginalDecimal',
                'saleProceedsOriginalDecimal',
                'feesOriginalDecimal'
              ]) &&
              data.cryptoRealizedDetails.keys().hasOnly([
                'costBasisOriginalDecimal',
                'saleProceedsOriginalDecimal',
                'feesOriginalDecimal'
              ]) &&
              isNonNegativeAmountDecimal(data.cryptoRealizedDetails.costBasisOriginalDecimal) &&
              isNonNegativeAmountDecimal(data.cryptoRealizedDetails.saleProceedsOriginalDecimal) &&
              isNonNegativeAmountDecimal(data.cryptoRealizedDetails.feesOriginalDecimal));
    }

    function hasValidIncomeKind(data) {
      return (data.source == 'CRYPTO' &&
              data.entryKind == 'REALIZED_PNL' &&
              'pnlDirection' in data &&
              data.pnlDirection in ['GAIN', 'LOSS', 'BREAK_EVEN'] &&
              (data.money.baseAmountMinor > 0 ||
               ('cryptoRealizedDetails' in data &&
                data.pnlDirection == 'BREAK_EVEN' &&
                data.money.baseAmountMinor == 0))) ||
             (data.source in ['SALARY', 'FREELANCE', 'ADSENSE'] &&
              data.entryKind == 'RECEIPT' &&
              !('pnlDirection' in data) &&
              !('cryptoRealizedDetails' in data) &&
              data.money.baseAmountMinor > 0);
    }

    function hasValidReceivableFields(data) {
      return data.keys().hasAll([
               'schemaVersion', 'id', 'title', 'projectReference',
               'expectedOriginalDecimal', 'currency', 'expectedDate', 'archived'
             ]) &&
             data.keys().hasOnly([
               'schemaVersion', 'id', 'title', 'projectReference',
               'expectedOriginalDecimal', 'currency', 'expectedDate', 'archived'
             ]);
    }

    function isValidReceivableData(data, receivableId) {
      return hasValidReceivableFields(data) &&
             data.schemaVersion is int &&
             data.schemaVersion == 1 &&
             data.id is string && data.id == receivableId &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.projectReference is string &&
             data.projectReference.size() > 0 && data.projectReference.size() <= 200 &&
             isPositiveAmountDecimal(data.expectedOriginalDecimal) &&
             data.currency in ['LKR', 'USD'] &&
             isIsoDate(data.expectedDate) &&
             data.archived is bool;
    }

    function hasValidReceivableLink(data, userId) {
      return !('receivableId' in data) ||
             (data.receivableId is string &&
              data.receivableId.size() > 0 &&
              data.source == 'FREELANCE' &&
              data.entryKind == 'RECEIPT' &&
              exists(/databases/$(database)/documents/users/$(userId)/receivables/$(data.receivableId)) &&
              get(/databases/$(database)/documents/users/$(userId)/receivables/$(data.receivableId)).data.archived == false &&
              get(/databases/$(database)/documents/users/$(userId)/receivables/$(data.receivableId)).data.currency == data.money.originalCurrency);
    }

    function isValidIncomeData(data, userId, incomeId) {
      return hasValidIncomeFields(data) &&
             data.schemaVersion is int &&
             data.schemaVersion == 1 &&
             data.id is string &&
             data.id == incomeId &&
             data.source is string &&
             data.source in ['SALARY', 'FREELANCE', 'ADSENSE', 'CRYPTO'] &&
             data.entryKind is string &&
             data.entryKind in ['RECEIPT', 'REALIZED_PNL'] &&
             isIsoDate(data.occurredDate) &&
             hasValidMoneyFields(data.money) &&
             hasValidMoneyTypes(data.money) &&
             (isPositiveAmountDecimal(data.money.originalAmountDecimal) ||
              ('cryptoRealizedDetails' in data &&
               data.pnlDirection == 'BREAK_EVEN' &&
               data.money.originalAmountDecimal.matches('0+([.]0{1,2})?'))) &&
             hasValidCurrencyAndRate(data) &&
             hasValidOptionalIncomeTypes(data) &&
             hasValidIncomeKind(data) &&
             hasValidCryptoRealizedDetails(data) &&
             hasValidReceivableLink(data, userId);
    }

    function isValidGoalData(data, goalId) {
      return data.keys().hasAll([
               'schemaVersion',
               'id',
               'name',
               'targetAmountMinor',
               'startDate',
               'targetDate',
               'archived'
             ]) &&
             data.keys().hasOnly([
               'schemaVersion',
               'id',
               'name',
               'targetAmountMinor',
               'startDate',
               'targetDate',
               'archived'
             ]) &&
             data.schemaVersion == 1 &&
             data.id is string &&
             data.id == goalId &&
             data.name is string &&
             data.name.size() > 0 &&
             data.targetAmountMinor is int &&
             data.targetAmountMinor > 0 &&
             isIsoDate(data.startDate) &&
             isIsoDate(data.targetDate) &&
             data.targetDate >= data.startDate &&
             data.archived is bool;
    }

    function hasValidContributionFields(data) {
      return data.keys().hasAll([
               'schemaVersion',
               'id',
               'goalId',
               'amountMinor',
               'kind',
               'occurredDate'
             ]) &&
             data.keys().hasOnly([
               'schemaVersion',
               'id',
               'goalId',
               'amountMinor',
               'kind',
               'occurredDate',
               'reversesId',
               'note'
             ]);
    }

    function isValidReversal(data, userId, goalId, contributionId) {
      let originalPath = /databases/$(database)/documents/users/$(userId)/goals/$(goalId)/contributions/$(data.reversesId);
      let claimPath = /databases/$(database)/documents/users/$(userId)/goals/$(goalId)/reversalClaims/$(data.reversesId);
      return data.amountMinor < 0 &&
             data.reversesId is string &&
             data.reversesId.size() > 0 &&
             exists(originalPath) &&
             get(originalPath).data.kind != 'REVERSAL' &&
             get(originalPath).data.amountMinor is int &&
             data.amountMinor + get(originalPath).data.amountMinor == 0 &&
             existsAfter(claimPath) &&
             getAfter(claimPath).data.reversalContributionId == contributionId &&
             getAfter(claimPath).data.originalContributionId == data.reversesId;
    }

    function isValidContributionData(data, userId, goalId, contributionId) {
      return hasValidContributionFields(data) &&
             data.schemaVersion == 1 &&
             data.id is string &&
             data.id == contributionId &&
             data.goalId is string &&
             data.goalId == goalId &&
             data.amountMinor is int &&
             data.kind is string &&
             data.kind in ['OPENING', 'ALLOCATION', 'REVERSAL'] &&
             isIsoDate(data.occurredDate) &&
             (!('note' in data) || data.note is string) &&
             exists(/databases/$(database)/documents/users/$(userId)/goals/$(goalId)) &&
             ((data.kind in ['OPENING', 'ALLOCATION'] &&
               data.amountMinor > 0 &&
               !('reversesId' in data)) ||
              (data.kind == 'REVERSAL' &&
               isValidReversal(data, userId, goalId, contributionId)));
    }

    function isValidReversalClaim(data, userId, goalId, originalId) {
      let reversalPath = /databases/$(database)/documents/users/$(userId)/goals/$(goalId)/contributions/$(data.reversalContributionId);
      return data.keys().hasAll([
               'schemaVersion',
               'originalContributionId',
               'reversalContributionId'
             ]) &&
             data.keys().hasOnly([
               'schemaVersion',
               'originalContributionId',
               'reversalContributionId'
             ]) &&
             data.schemaVersion == 1 &&
             data.originalContributionId == originalId &&
             data.reversalContributionId is string &&
             existsAfter(reversalPath) &&
             getAfter(reversalPath).data.kind == 'REVERSAL' &&
             getAfter(reversalPath).data.reversesId == originalId;
    }

    // User document access
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // FCM installation registrations are write-only to their authenticated owner. A trusted
      // backend uses Admin SDK access when sending and is not governed by these rules.
      match /fcmRegistrations/{registrationId} {
        allow create, update: if isVerifiedOwner(userId) &&
                              isValidFcmRegistrationData(request.resource.data, userId);
        // Sign-out cleanup must remain available before email verification. The path is
        // still UID scoped, and clients cannot read or list registration documents.
        allow delete: if isOwner(userId);
        allow get, list: if false;
      }

      // Scoped expenses collection for signed-in user
      match /expenses/{expenseId} {
        allow read: if isVerifiedOwner(userId);
        allow create: if isVerifiedOwner(userId) &&
                      isValidExpenseData(request.resource.data, userId, expenseId);
        allow update: if isVerifiedOwner(userId) &&
                      isValidExpenseData(request.resource.data, userId, expenseId) &&
                      preservesExpenseRecurringLink(resource.data, request.resource.data);
        allow delete: if isVerifiedOwner(userId) &&
                      hasNoRecurringExpenseLink(resource.data);
      }

      // Recurring templates are retained when paused or cancelled.
      match /recurringExpenses/{recurringId} {
        allow get, list: if isVerifiedOwner(userId);
        allow create, update: if isVerifiedOwner(userId) &&
                              isValidRecurringExpenseData(
                                request.resource.data,
                                userId,
                                recurringId
                              );
        allow delete: if false;
      }

      // Only confirmed and skipped actions are persisted; pending dates are derived.
      match /recurringOccurrences/{occurrenceId} {
        allow get, list: if isVerifiedOwner(userId);
        allow create: if isVerifiedOwner(userId) &&
                      isValidRecurringOccurrenceData(
                        request.resource.data,
                        userId,
                        occurrenceId
                      );
        allow update, delete: if false;
      }

      // UID-scoped expense categories. Categories are archived, never deleted.
      match /categories/{categoryId} {
        allow get, list: if isVerifiedOwner(userId);
        allow create, update: if isVerifiedOwner(userId) &&
                              isValidCategoryData(request.resource.data, categoryId);
        allow delete: if false;
      }

      // UID-scoped income reads and complete-schema writes.
      match /incomes/{incomeId} {
        allow get, list: if isVerifiedOwner(userId);
        allow create, update: if isVerifiedOwner(userId) &&
                              isValidIncomeData(request.resource.data, userId, incomeId);
        allow delete: if isVerifiedOwner(userId);
      }

      match /receivables/{receivableId} {
        allow get, list: if isVerifiedOwner(userId);
        allow create: if isVerifiedOwner(userId) &&
                         isValidReceivableData(request.resource.data, receivableId);
        allow update: if isVerifiedOwner(userId) &&
                         isValidReceivableData(request.resource.data, receivableId) &&
                         request.resource.data.currency == resource.data.currency;
        allow delete: if false;
      }

      // UID-scoped goals and immutable contribution ledger entries.
      match /goals/{goalId} {
        allow get, list: if isVerifiedOwner(userId);
        allow create, update: if isVerifiedOwner(userId) &&
                              isValidGoalData(request.resource.data, goalId);
        allow delete: if false;

        match /contributions/{contributionId} {
          allow get, list: if isVerifiedOwner(userId);
          allow create: if isVerifiedOwner(userId) &&
                        isValidContributionData(
                          request.resource.data,
                          userId,
                          goalId,
                          contributionId
                        );
          allow update, delete: if false;
        }

        match /reversalClaims/{originalId} {
          allow get: if isVerifiedOwner(userId);
          allow create: if isVerifiedOwner(userId) &&
                        isValidReversalClaim(
                          request.resource.data,
                          userId,
                          goalId,
                          originalId
                        );
          allow list, update, delete: if false;
        }
      }
    }

    // Fallback default deny for any unmatched path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
